# Appwrite
VITE_APPWRITE_ENDPOINT=https://appwrite.kabirstudios.com/v1
VITE_APPWRITE_PROJECT=medscope
VITE_APPWRITE_DATABASE_ID=medscope

# AI vision (OpenAI-compatible). VITE_ vars ship in the client bundle —
# use a restricted key or a proxy URL that keeps the real key server-side.
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

