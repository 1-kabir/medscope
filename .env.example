# Appwrite
VITE_APPWRITE_ENDPOINT=https://appwrite.kabirstudios.com/v1
VITE_APPWRITE_PROJECT=medscope
VITE_APPWRITE_DATABASE_ID=medscope

# AI vision (OpenAI-compatible). These are set as Appwrite Function variables
# on `ai-proxy` (run functions/deploy-ai-proxy.cjs after adding them here) —
# the browser talks only to the proxy, the key stays server-side.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Server-side secrets (Appwrite Functions env, NOT exposed to the browser)
# SARVAM_API_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
